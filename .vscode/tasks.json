{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LeetCode: run active file",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "LeetCode: build active file",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "args": [
                "--build",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
