# Claude Code local state (machine-specific permission allowlist, absolute paths)
.claude/

# Build output. run.sh compiles to ~/Library/Caches/leetcode_cpp/, but stray
# binaries from manual clang++ invocations land here.
a.out
*.o
*.dSYM/
ref_*
!ref_*.cpp

# VS Code extension build artifact, regenerated by tools/leetcode-buttons/build.sh
*.vsix
node_modules/

# macOS
.DS_Store
